// Phase 1 schema: full core domain for US country / yacht / golf clubs.
// All money in cents. All datetimes UTC. Soft-delete via deletedAt where audit
// matters. Foreign keys cascade on the parent and restrict on lookup tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth & users
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  STAFF
  MEMBER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          UserRole  @default(MEMBER)
  capabilities      Json      @default("[]")
  passToken         String?   @unique
  memberId          String?   @unique
  notificationPrefs Json      @default("{}")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  member   Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  accounts Account[]
  sessions Session[]

  postedHouseCharges HouseCharge[] @relation("HouseChargePostedBy")
  uploadedAssets     MediaAsset[]
  createdTasks       Task[]        @relation("TaskCreatedBy")
  assignedTasks      Task[]        @relation("TaskAssignedTo")
  auditEvents        AuditEvent[]
  sentMessages       Message[]     @relation("MessageSentBy")
  mcpAuthorizations  MCPAuthorization[]
  mcpTokens          MCPToken[]
  createdRefunds     Refund[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Members
// ─────────────────────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  OTHER
  PREFER_NOT_TO_SAY
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  RESIGNED
  DECEASED
}

model Member {
  id               String           @id @default(cuid())
  memberNumber     String?          @unique
  firstName        String
  lastName         String
  email            String?          @unique
  phone            String?
  gender           Gender?
  pronouns         String?
  birthDate        DateTime?        @db.Date
  joinDate         DateTime?        @db.Date
  membershipClass  String?
  membershipStatus MembershipStatus @default(ACTIVE)
  sponsorId        String?
  spouseId         String?          @unique
  photoUrl         String?
  customFields     Json             @default("{}")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  user      User?
  sponsor   Member?  @relation("MemberSponsor", fields: [sponsorId], references: [id], onDelete: SetNull)
  sponsored Member[] @relation("MemberSponsor")
  spouse    Member?  @relation("MemberSpouse", fields: [spouseId], references: [id], onDelete: SetNull)
  spouseOf  Member?  @relation("MemberSpouse")

  addresses             Address[]
  dependents            Dependent[]
  groupMemberships      GroupMembership[]
  committeeMemberships  CommitteeMembership[]
  invoices              Invoice[]
  houseCharges          HouseCharge[]
  statements            Statement[]
  eventAttendances      EventAttendance[]
  complianceCertificates ComplianceCertificate[]
  feedback              Feedback[]
  linkedTasks           Task[]
  checkinLogs           CheckinLog[]
  conversations         Conversation[]
  paymentMethods        SavedPaymentMethod[]

  twilioOptedOut    Boolean @default(false)
  stripeCustomerId  String? @unique

  @@index([lastName, firstName])
  @@index([membershipStatus])
  @@index([deletedAt])
}

model Address {
  id           String  @id @default(cuid())
  memberId     String
  street1      String
  street2      String?
  city         String
  state        String
  zip          String
  country      String  @default("US")
  isPrimary    Boolean @default(false)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

model Dependent {
  id           String    @id @default(cuid())
  memberId     String
  name         String
  relationship String
  birthDate    DateTime? @db.Date

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Groups & committees
// ─────────────────────────────────────────────────────────────────────────────

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String?
  customFields Json    @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  memberships GroupMembership[]

  @@index([deletedAt])
}

model GroupMembership {
  id       String  @id @default(cuid())
  groupId  String
  memberId String
  role     String?

  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([groupId, memberId])
}

model Committee {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  memberships CommitteeMembership[]

  @@index([deletedAt])
}

model CommitteeMembership {
  id          String  @id @default(cuid())
  committeeId String
  memberId    String
  role        String?

  committee Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([committeeId, memberId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Events & RSVP / ticketing
// ─────────────────────────────────────────────────────────────────────────────

model Event {
  id            String    @id @default(cuid())
  title         String
  description   String?
  startAt       DateTime
  endAt         DateTime
  venue         String?
  capacity      Int?
  memberPriceCents Int    @default(0)
  guestPriceCents  Int    @default(0)
  rsvpDeadline  DateTime?
  isTicketed    Boolean   @default(false)
  publicToken   String    @unique @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  attendances EventAttendance[]

  @@index([startAt])
  @@index([deletedAt])
}

enum AttendanceStatus {
  GOING
  MAYBE
  DECLINED
  WAITLIST
}

model EventAttendance {
  id              String           @id @default(cuid())
  eventId         String
  memberId        String?
  guestName       String?
  guestEmail      String?
  status          AttendanceStatus @default(GOING)
  ticketPaidAt    DateTime?
  paymentId       String?
  createdAt       DateTime         @default(now())

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member  Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([eventId, memberId])
  @@index([eventId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Calendar (read-only and external feeds, separate from RSVPable Events)
// ─────────────────────────────────────────────────────────────────────────────

enum CalendarSource {
  INTERNAL
  ICAL_FEED
}

model CalendarEvent {
  id        String         @id @default(cuid())
  title     String
  start     DateTime
  end       DateTime
  allDay    Boolean        @default(false)
  location  String?
  source    CalendarSource @default(INTERNAL)
  feedUrl   String?
  createdAt DateTime       @default(now())

  @@index([start])
}

// ─────────────────────────────────────────────────────────────────────────────
// Invoicing & installments
// ─────────────────────────────────────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
  REFUNDED
}

enum InvoiceKind {
  DUES
  EVENT
  STATEMENT
  ASSESSMENT
  OTHER
}

enum InstallmentStatus {
  PENDING
  SENT
  PAID
}

enum PaymentMethod {
  CARD
  ACH
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  memberId      String
  status        InvoiceStatus @default(DRAFT)
  kind          InvoiceKind   @default(OTHER)
  currency      String        @default("USD")
  totalCents    Int
  dueDate       DateTime?     @db.Date
  paymentToken  String        @unique @default(cuid())
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  paidAt        DateTime?

  member       Member        @relation(fields: [memberId], references: [id], onDelete: Restrict)
  lines        InvoiceLine[]
  installments Installment[]
  payments     Payment[]
  statement    Statement?
  houseCharges HouseCharge[]

  @@index([memberId])
  @@index([status])
  @@index([dueDate])
}

model InvoiceLine {
  id          String      @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int         @default(1)
  unitCents   Int
  totalCents  Int
  kind        InvoiceKind @default(OTHER)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Installment {
  id                String            @id @default(cuid())
  invoiceId         String
  sequence          Int
  amountCents       Int
  adminFeeCents     Int               @default(0)
  dueDate           DateTime          @db.Date
  status            InstallmentStatus @default(PENDING)
  providerName      String?
  providerPaymentId String?           @unique
  paymentLinkUrl    String?
  sentAt            DateTime?
  paidAt            DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, sequence])
  @@index([dueDate])
  @@index([status])
}

model Payment {
  id                String        @id @default(cuid())
  invoiceId         String?
  providerName      String
  providerPaymentId String        @unique
  amountCents       Int
  currency          String        @default("USD")
  method            PaymentMethod @default(CARD)
  status            PaymentStatus @default(PENDING)
  rawWebhookJson    Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  invoice          Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  eventAttendances EventAttendance[]
  refunds          Refund[]

  @@index([invoiceId])
  @@index([providerName, providerPaymentId])
}

model Refund {
  id                String   @id @default(cuid())
  paymentId         String
  amountCents       Int
  currency          String   @default("USD")
  reason            String?
  providerName      String
  providerRefundId  String   @unique
  status            String   @default("succeeded")
  rawWebhookJson    Json?
  createdById       String?
  createdAt         DateTime @default(now())

  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([paymentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// House accounts
// ─────────────────────────────────────────────────────────────────────────────

model HouseCharge {
  id           String   @id @default(cuid())
  memberId     String
  category     String
  amountCents  Int
  occurredOn   DateTime @db.Date
  memo         String?
  postedById   String?
  invoiceId    String?
  createdAt    DateTime @default(now())

  member   Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  postedBy User?    @relation("HouseChargePostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  invoice  Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([memberId, occurredOn])
  @@index([invoiceId])
}

model Statement {
  id          String   @id @default(cuid())
  memberId    String
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  invoiceId   String   @unique
  generatedAt DateTime @default(now())

  member  Member  @relation(fields: [memberId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([memberId, periodStart])
}

// ─────────────────────────────────────────────────────────────────────────────
// Compliance / background check
// ─────────────────────────────────────────────────────────────────────────────

enum ComplianceStatus {
  PENDING
  CERTIFIED
  EXPIRED
  REVOKED
}

model ComplianceCertificate {
  id          String           @id @default(cuid())
  memberId    String
  type        String
  status      ComplianceStatus @default(PENDING)
  certifiedOn DateTime?        @db.Date
  expiresOn   DateTime?        @db.Date
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([expiresOn])
}

// ─────────────────────────────────────────────────────────────────────────────
// Tasks, feedback, reminders
// ─────────────────────────────────────────────────────────────────────────────

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  ARCHIVED
}

model Task {
  id             String     @id @default(cuid())
  title          String
  description    String?
  dueDate        DateTime?  @db.Date
  status         TaskStatus @default(OPEN)
  assigneeId     String?
  createdById    String
  linkedMemberId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  assignee     User?    @relation("TaskAssignedTo", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User     @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  linkedMember Member?  @relation(fields: [linkedMemberId], references: [id], onDelete: SetNull)

  @@index([assigneeId])
  @@index([status])
}

enum FeedbackStatus {
  NEW
  TRIAGED
  RESOLVED
  WONT_FIX
}

model Feedback {
  id        String         @id @default(cuid())
  memberId  String?
  page      String?
  message   String
  status    FeedbackStatus @default(NEW)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
}

model Reminder {
  id          String    @id @default(cuid())
  kind        String
  dueAt       DateTime
  sentAt      DateTime?
  payloadJson Json
  createdAt   DateTime  @default(now())

  @@index([dueAt, sentAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Member pass / check-in
// ─────────────────────────────────────────────────────────────────────────────

model CheckinLog {
  id        String   @id @default(cuid())
  memberId  String
  scannedAt DateTime @default(now())
  location  String?
  notes     String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, scannedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Settings, media, audit, webhook idempotency
// ─────────────────────────────────────────────────────────────────────────────

model Setting {
  key       String   @id
  valueJson Json
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id           String   @id @default(cuid())
  url          String
  contentType  String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime @default(now())

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
}

model WebhookEvent {
  id              String    @id @default(cuid())
  providerName    String
  providerEventId String
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  rawJson         Json

  @@unique([providerName, providerEventId])
  @@index([processedAt])
}

model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  diffJson  Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Twilio messaging
// ─────────────────────────────────────────────────────────────────────────────

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  RECEIVED
}

model Conversation {
  id            String   @id @default(cuid())
  memberId      String?
  phone         String   @unique
  lastMessageAt DateTime @default(now())
  unread        Boolean  @default(false)
  optedOut     Boolean  @default(false)
  createdAt     DateTime @default(now())

  member   Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([memberId, lastMessageAt])
  @@index([lastMessageAt])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  body           String?
  mediaUrls      Json             @default("[]")
  status         MessageStatus
  twilioSid      String?          @unique
  errorCode      String?
  errorMessage   String?
  sentById       String?
  createdAt      DateTime         @default(now())
  deliveredAt    DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sentBy       User?        @relation("MessageSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([twilioSid])
}

model OutboundOptOut {
  phone     String   @id
  reason    String?
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Card-on-file payment methods (distinct from the PaymentMethod enum on
// historical Payment rows, which records the channel of a single transaction).
// ─────────────────────────────────────────────────────────────────────────────

model SavedPaymentMethod {
  id                    String        @id @default(cuid())
  memberId              String
  stripePaymentMethodId String        @unique
  kind                  PaymentMethod
  brand                 String?
  last4                 String
  expMonth              Int?
  expYear               Int?
  isDefault             Boolean       @default(false)
  createdAt             DateTime      @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

// ─────────────────────────────────────────────────────────────────────────────
// MCP (Model Context Protocol) — OAuth 2.1 + DCR + bearer tokens
// ─────────────────────────────────────────────────────────────────────────────

model MCPClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  name         String
  redirectUris Json
  createdAt    DateTime @default(now())

  authorizations MCPAuthorization[]
  tokens         MCPToken[]
}

model MCPAuthorization {
  id            String   @id @default(cuid())
  userId        String
  mcpClientId   String
  scopes        Json
  code          String?  @unique
  codeChallenge String?
  redirectUri   String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mcpClient MCPClient @relation(fields: [mcpClientId], references: [clientId], onDelete: Cascade)

  @@index([userId])
}

model MCPToken {
  id         String    @id @default(cuid())
  userId     String
  mcpClientId String
  tokenHash  String    @unique
  scopes     Json
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mcpClient MCPClient @relation(fields: [mcpClientId], references: [clientId], onDelete: Cascade)

  @@index([userId])
  @@index([mcpClientId])
}
