# --- Database ---
DATABASE_URL="postgresql://club:club@localhost:5432/club?schema=public"

# --- Auth.js ---
AUTH_SECRET="change-me-32-bytes-minimum"
AUTH_URL="http://localhost:3000"

# --- Magic-link email (Auth.js Email provider) ---
# Local dev: Mailpit at smtp://localhost:1025
EMAIL_SERVER="smtp://localhost:1025"
EMAIL_FROM="Club OS <noreply@club.local>"

# --- Stripe (Phase 3) ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Amazon SES (Phase 5) ---
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SES_FROM_ADDRESS=""

# --- Cloudflare R2 / S3 (file storage) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# --- Per-club configuration ---
CLUB_NAME="Pinehurst Country Club"
CLUB_LOCALE="en-US"
CLUB_CURRENCY="USD"
CLUB_TIMEZONE="America/New_York"
CLUB_PUBLIC_URL="http://localhost:3000"
