# Public base URL of the Club OS API (Next.js app).
# This goes through to the device; nothing secret here — the OAuth flow
# happens in the user's browser and the bearer token is held in the OS
# secure storage on-device, not in env.
EXPO_PUBLIC_CLUB_OS_API_BASE=http://localhost:3000

# Optional: a pre-registered MCP OAuth client_id. If unset, the app
# registers itself via Dynamic Client Registration on first launch.
EXPO_PUBLIC_MCP_CLIENT_ID=
